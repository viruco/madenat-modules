<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lumber_shipment_rebaja_wizard_form" model="ir.ui.view">
        <field name="name">lumber.shipment.rebaja.wizard.form</field>
        <field name="model">lumber.shipment.rebaja.wizard</field>
        <field name="arch" type="xml">
            <form string="Rebajar por nave">
                <group>
                    <group string="Alcance">
                        <field name="vessel_id" options="{'no_create': True}"/>
                        <field name="voyage_id" options="{'no_create': True}"/>
                    </group>
                    <group string="Pendientes de rebaja">
                        <field name="container_count"/>
                        <field name="total_nominal_m3"/>
                    </group>
                </group>
                <field name="available_container_ids" invisible="1"/>
                <label for="container_ids"
                       string="Contenedores consolidados (Cargado/Sellado) del alcance"/>
                <field name="container_ids"
                       nolabel="1"
                       context="{'list_view_ref': 'madenat_lumber_logistics.view_lumber_container_list'}"/>
                <field name="result_message" readonly="1"/>
                <footer>
                    <button name="action_rebajar"
                            string="Rebajar seleccionados"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lumber_shipment_rebaja_wizard" model="ir.actions.act_window">
        <field name="name">Rebajar por nave</field>
        <field name="res_model">lumber.shipment.rebaja.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
