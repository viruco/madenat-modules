<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- I1 canónico (CANON/19 §16): Asistente «Envío a procesador». -->
        <record id="view_madenat_processor_shipment_wizard_form" model="ir.ui.view">
            <field name="name">madenat.processor.shipment.wizard.form</field>
            <field name="model">madenat.processor.shipment.wizard</field>
            <field name="arch" type="xml">
                <form string="Envío a procesador">
                    <group>
                        <group>
                            <field name="processor_id"/>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                        </group>
                        <group>
                            <field name="note"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom" create="0">
                            <field name="source_location_id" column_invisible="1"/>
                            <field name="lot_id"/>
                            <field name="product_id"/>
                            <field name="lot_flow_type"/>
                            <field name="physical_qty"/>
                            <field name="reserved_qty"/>
                            <field name="available_qty"/>
                            <field name="quantity"/>
                            <field name="uom_id" column_invisible="1"/>
                        </list>
                    </field>
                    <group>
                        <field name="reason"
                               placeholder="Opcional: solo si existe una referencia previa persistida y la cantidad difiere de ella (AD-89)"/>
                    </group>
                    <footer>
                        <button name="action_send" type="object" string="Enviar"
                                class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary"
                                special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_madenat_processor_shipment_wizard" model="ir.actions.act_window">
            <field name="name">Envío a procesador</field>
            <field name="res_model">madenat.processor.shipment.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="context">{'active_model': 'stock.lot'}</field>
        </record>

        <!-- Acción servidor en la lista de lotes: «Enviar a procesador». -->
        <record id="action_server_lot_send_to_processor" model="ir.actions.server">
            <field name="name">Enviar a procesador</field>
            <field name="model_id" ref="stock.model_stock_lot"/>
            <field name="binding_model_id" ref="stock.model_stock_lot"/>
            <field name="binding_view_types">list,form</field>
            <field name="state">code</field>
            <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Envío a procesador',
    'res_model': 'madenat.processor.shipment.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'active_model': 'stock.lot', 'active_ids': records.ids},
}
            </field>
        </record>

    </data>
</odoo>
