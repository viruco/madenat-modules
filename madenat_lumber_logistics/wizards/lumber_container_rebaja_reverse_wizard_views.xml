<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lumber_container_rebaja_reverse_wizard_form" model="ir.ui.view">
        <field name="name">lumber.container.rebaja.reverse.wizard.form</field>
        <field name="model">lumber.container.rebaja.reverse.wizard</field>
        <field name="arch" type="xml">
            <form string="Reversa con override de Gerencia">
                <div class="alert alert-danger" role="alert">
                    El embarque está entregado o el viaje cancelado. Revertir la
                    rebaja requiere autorización de Gerencia con motivo. La
                    acción quedará auditada.
                </div>
                <group>
                    <field name="container_id" readonly="1"/>
                    <field name="reason" placeholder="Motivo del override..."/>
                </group>
                <footer>
                    <button name="action_confirm_override" type="object"
                            string="Autorizar y revertir" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
