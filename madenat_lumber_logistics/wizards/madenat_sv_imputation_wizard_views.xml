<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- I2 (CANON/19 v1.6.0 / AD-91): asistente de imputación documental SV. -->
    <record id="view_madenat_sv_imputation_wizard_form" model="ir.ui.view">
        <field name="name">madenat.sv.imputation.wizard.form</field>
        <field name="model">madenat.sv.imputation.wizard</field>
        <field name="arch" type="xml">
            <form string="Registrar rebaja" class="o_xxl_form_view">
                <!-- UI (2026-10-11): acciones operativas en el HEADER nativo. El
                     asistente se abre como formulario amplio (target=current), y
                     un <footer> NO se renderiza fuera de un diálogo; por eso las
                     acciones eran invisibles en el recorrido real. -->
                <header>
                    <!-- Simplificación (2026-10-11): recorrido de DOS acciones.
                         Guardar = persistir para continuar; Aplicar = ejecutar la
                         rebaja. Ambas en la misma ventana; NO exigen «Preparar
                         asignación» ni Guardar previo ni abrir el documento. -->
                    <button name="action_prepare" type="object"
                            string="Guardar" class="btn-primary"
                            invisible="imputation_state in ('applied', 'reversed', 'cancelled')"/>
                    <button name="action_apply" type="object"
                            string="Aplicar" class="btn-primary"
                            groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_jefatura_operaciones,madenat_lumber_core.group_madenat_gerencia"
                            invisible="imputation_state in ('applied', 'reversed', 'cancelled')"/>
                    <button name="action_discard_changes" type="object"
                            string="Volver" class="btn-secondary"
                            confirm="Si hay cambios sin guardar se perderán. ¿Volver al SV?"/>
                    <button name="action_wizard_reopen" type="object"
                            string="Volver a borrador"
                            groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_jefatura_operaciones,madenat_lumber_core.group_madenat_gerencia"
                            invisible="imputation_state != 'cancelled'"/>
                    <!-- LOCK (2026-10-12): recuperación del conflicto de edición
                         concurrente. Descarta los cambios locales NO guardados y
                         reconstruye la representación desde el documento vigente. -->
                    <button name="action_reload_current" type="object"
                            string="Recargar versión actual"
                            confirm="Se descartarán los cambios NO guardados y se recargará la versión vigente del documento. ¿Continuar?"/>
                    <field name="imputation_state" invisible="1"/>
                    <field name="expected_edit_version" invisible="1"/>
                    <field name="save_result" invisible="1"/>
                    <field name="apply_result" invisible="1"/>
                </header>
                <div class="alert alert-success mb-1" role="alert"
                     invisible="not save_result">
                    <field name="save_result" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-success mb-1" role="alert"
                     invisible="not apply_result">
                    <field name="apply_result" readonly="1" nolabel="1"/>
                </div>
                <group>
                    <group string="Operación">
                        <field name="sv_lot_id"/>
                        <field name="guia_processing_id"
                               readonly="imputation_id"/>
                        <field name="sv_documental_balance_m3" readonly="1"/>
                        <field name="processor_id"/>
                        <field name="imputation_id" readonly="1"/>
                    </group>
                    <group string="Resumen de la operación">
                        <!-- Carga explícita del flag para `column_invisible` de
                             las listas hijas (`parent.multi_sv`). -->
                        <field name="multi_sv" invisible="1"/>
                        <field name="selected_line_count" readonly="1"/>
                        <field name="prepared_line_count" readonly="1"/>
                        <field name="prepared_total_m3" readonly="1"/>
                        <field name="assigned_total_m3" readonly="1"
                               invisible="not multi_sv"/>
                        <field name="packing_pieces_total" readonly="1"/>
                        <field name="packing_documental_volume_total_m3"
                               readonly="1"/>
                        <field name="available_total_m3" readonly="1"/>
                        <field name="not_assignable_line_count" readonly="1"
                               invisible="not not_assignable_line_count"/>
                    </group>
                </group>
                <div class="text-muted" invisible="guia_processing_id">
                    Seleccione una guía confirmada como retorno de servicio
                    («¿Es retorno de servicio?» = Sí).
                </div>
                <div class="text-muted mb-1" invisible="not sv_lot_id">
                    <field name="assigned_summary" readonly="1" nolabel="1"/>
                </div>
                <div class="alert alert-warning mb-1" role="alert"
                     invisible="not not_assignable_line_count">
                    <field name="no_availability_note" readonly="1"
                           nolabel="1"/>
                    <button name="action_open_no_availability_docs"
                            type="object"
                            string="Ver documentos que explican el saldo"
                            class="btn-link"
                            invisible="not not_assignable_line_count"/>
                </div>
                <div class="alert alert-info mb-1" role="alert">
                    Rebaja documental: no mueve stock físico.
                </div>
                <div class="alert alert-warning mb-1" role="alert"
                     invisible="imputation_state != 'cancelled'">
                    Documento anulado. Pulsa «Volver a borrador» indicando el
                    motivo para reactivarlo; reabrir vuelve a activar las
                    <b>reservas previstas de borrador</b>.
                </div>
                <group string="Más opciones (avanzado)">
                    <field name="reopen_reason"
                           placeholder="Motivo de reapertura (obligatorio para Volver a borrador)"
                           invisible="imputation_state != 'cancelled'"/>
                    <button name="action_open_document" type="object"
                            string="Abrir documento"
                            invisible="not imputation_id"
                            help="Consulta opcional del documento persistente. No es requisito para Guardar ni Aplicar."/>
                    <button name="action_pending" type="object"
                            string="Dejar pendiente"
                            invisible="imputation_state in ('applied', 'reversed', 'cancelled')"/>
                    <button name="action_propose_fifo" type="object"
                            string="Proponer FIFO"
                            invisible="imputation_state in ('applied', 'reversed', 'cancelled')"/>
                </group>
                <notebook>
                    <page string="Materiales del retorno">
                        <div class="mb-2">
                            <button name="action_select_all" type="object"
                                    string="Seleccionar todas"
                                    class="btn-secondary"
                                    help="Marca todas las etiquetas del retorno. Sólo selecciona; no asigna ni aplica."/>
                            <button name="action_clear_selection" type="object"
                                    string="Quitar selección"
                                    class="btn-secondary"
                                    help="Quita la selección y descarta el reparto transitorio del asistente."/>
                            <button name="action_assign_selected" type="object"
                                    string="Preparar asignación"
                                    class="btn-primary"
                                    help="Prepara el reparto al SV de trabajo; no aplica la rebaja."/>
                            <button name="action_use_available" type="object"
                                    string="Usar disponible"
                                    class="btn-secondary"
                                    help="Rellena los m³ disponibles en las filas del SV de trabajo que aún están en cero (etiquetas seleccionadas). No sobrescribe lo editado ni aplica."/>
                        </div>
                        <field name="line_ids"
                               readonly="imputation_state in ('applied', 'reversed', 'cancelled')">
                            <list editable="bottom" create="false"
                                  delete="false">
                                <field name="asignable" column_invisible="True"/>
                                <field name="selected"
                                       widget="boolean_toggle"
                                       readonly="not asignable"/>
                                <!-- Identificación (etiqueta limpia) -->
                                <field name="etiqueta" readonly="1"/>
                                <field name="sku_origen" readonly="1"/>
                                <!-- Descripción -->
                                <field name="producto_id" readonly="1"/>
                                <!-- Dimensiones técnicas -->
                                <field name="espesor_mm" readonly="1"/>
                                <field name="ancho_mm" readonly="1"/>
                                <field name="largo_m" readonly="1"/>
                                <!-- Cantidades de origen -->
                                <field name="piezas_lote" readonly="1"
                                       sum="Piezas"/>
                                <field name="volumen_documental_m3"
                                       readonly="1"
                                       sum="Vol. documental (m³)"/>
                                <!-- Operación -->
                                <field name="etiqueta_disponible_m3"
                                       readonly="1"
                                       sum="Disponible (m³)"/>
                                <field name="cantidad_asignar_m3"/>
                                <!-- Causa del saldo (concreta y trazable, §15) -->
                                <field name="disponibilidad_estado"
                                       readonly="1"/>
                                <field name="disponibilidad_detalle"
                                       readonly="1" string="Causa del saldo"
                                       optional="show"/>
                                <button name="action_open_consuming_documents"
                                        type="object" string="Ver documentos"
                                        icon="fa-external-link"
                                        invisible="not disponibilidad_imputacion_ids"/>
                                <!-- Secundarias (opcionales) -->
                                <field name="subproducto_id" readonly="1"
                                       optional="hide"/>
                                <field name="espesor_declarado_mm"
                                       readonly="1" optional="hide"/>
                                <field name="ancho_declarado_mm"
                                       readonly="1" optional="hide"/>
                                <field name="largo_declarado_m"
                                       readonly="1" optional="hide"/>
                                <field name="volumen_embarque_m3"
                                       readonly="1" optional="hide"/>
                                <field name="lote_interno" readonly="1"
                                       optional="hide"
                                       string="Código técnico"/>
                                <!-- Documental avanzada (opcional) -->
                                <field name="etiqueta_nominal_m3"
                                       readonly="1" optional="hide"/>
                                <field name="nominal_volume_m3"
                                       optional="hide"/>
                                <field name="etiqueta_aplicado_m3"
                                       readonly="1" optional="hide"/>
                                <field name="etiqueta_reservado_m3"
                                       readonly="1" optional="hide"/>
                                <field name="etiqueta_pendiente_m3"
                                       readonly="1" optional="hide"/>
                                <!-- Identificador técnico obligatorio (envío
                                     al servidor garantizado con force_save) -->
                                <field name="processed_lot_id" readonly="1"
                                       force_save="1" optional="hide"
                                       string="Lote (técnico)"/>
                            </list>
                        </field>
                        <div class="alert alert-warning" role="alert"
                             invisible="line_ids or not guia_processing_id">
                            La guía seleccionada no tiene etiquetas de retorno
                            elegibles: no se han generado o no son elegibles
                            (todas de tipo Lote Volumen). Verifique la guía.
                        </div>
                        <p class="text-muted">
                            Selecciona el material, indica los m³ y prepara la
                            asignación. Sólo Aplicar registra la rebaja.
                        </p>
                    </page>
                    <page string="Sin disponibilidad" name="unavailable_material" invisible="not_assignable_line_count == 0">
                        <field name="line_ids" readonly="1">
                            <list create="false" delete="false">
                                <field name="asignable" column_invisible="True"/>
                                <field name="etiqueta"/>
                                <field name="sku_origen"/>
                                <field name="producto_id"/>
                                <field name="espesor_mm"/>
                                <field name="ancho_mm"/>
                                <field name="largo_m"/>
                                <field name="piezas_lote" sum="Piezas"/>
                                <field name="volumen_documental_m3" sum="Vol. documental (m³)"/>
                                <field name="etiqueta_disponible_m3" sum="Disponible (m³)"/>
                                <field name="disponibilidad_estado"/>
                                <field name="disponibilidad_detalle" string="Causa del saldo"/>
                                <button name="action_open_consuming_documents"
                                        type="object" string="Ver documentos"
                                        icon="fa-external-link"
                                        invisible="not disponibilidad_imputacion_ids"/>
                            </list>
                        </field>
                        <p class="text-muted">
                            Etiquetas de la guía sin disponibilidad documental para una nueva operación (consumidas o reservadas).
                        </p>
                    </page>
                    <page string="Asignación a SV">
                        <div class="mb-2">
                            <button name="action_use_available" type="object"
                                    string="Usar disponible"
                                    class="btn-secondary"
                                    help="Rellena los m³ disponibles en las filas del SV de trabajo que aún están en cero (etiquetas seleccionadas). No sobrescribe lo editado ni aplica."/>
                        </div>
                        <field name="sv_line_ids"
                               readonly="imputation_state in ('applied', 'reversed', 'cancelled')">
                            <list editable="bottom" create="false">
                                <field name="etiqueta" readonly="1"/>
                                <field name="medidas" readonly="1"/>
                                <field name="sku_origen" readonly="1"
                                       optional="hide"/>
                                <field name="etiqueta_disponible_m3"
                                       readonly="1"/>
                                <field name="imputed_volume_m3"
                                       string="A asignar (m³)"/>
                                <!-- column_invisible se evalúa con el contexto del
                                     PADRE (formulario), no con la fila: usar
                                     `parent.multi_sv` (no `wizard_id`, que no está
                                     definido en ese contexto → OwlError). -->
                                <field name="sv_lot_id" string="SV destino"
                                       column_invisible="not parent.multi_sv"/>
                                <field name="disponibilidad_estado"
                                       readonly="1" optional="hide"/>
                                <field name="disponibilidad_detalle"
                                       readonly="1" optional="hide"/>
                                <field name="etiqueta_retorno" readonly="1"
                                       optional="hide"
                                       string="Código técnico"/>
                            </list>
                        </field>
                        <p class="text-muted">
                            Ajusta los m³ por etiqueta y guarda o aplica. Sólo
                            Aplicar registra la rebaja documental.
                        </p>
                    </page>
                    <page string="Envíos relacionados">
                        <field name="eligible_shipment_picking_ids"
                               invisible="1"/>
                        <field name="shipment_picking_ids"
                               domain="[('id', 'in', eligible_shipment_picking_ids)]"
                               options="{'no_create': True}">
                            <list>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="date_done"/>
                                <field name="location_id"/>
                                <field name="location_dest_id"/>
                            </list>
                        </field>
                        <p class="text-muted">
                            Envíos elegibles (transferencias validadas al
                            procesador). La selección queda como propuesta
                            (borrador) y se REGISTRA al aplicar. Un envío puede
                            atender varios retornos parciales; un retorno puede
                            referir varios envíos (CANON/19 §19.11).
                        </p>
                    </page>
                    <page string="Motivo / reversa">
                        <group>
                            <field name="reason"
                                   placeholder="Motivo (obligatorio si hay exceso SV-side o falta de SV candidato)"/>
                            <field name="note"/>
                        </group>
                        <p class="text-muted">
                            La reversa de una imputación aplicada se realiza
                            desde el documento (acción «Reversar») con los
                            permisos vigentes de Jefatura/Gerencia; el asistente
                            no revierte ni reescribe historia.
                        </p>
                    </page>
                </notebook>
                <!-- UI (2026-10-11): acciones movidas al <header> nativo. El
                     <footer> no se renderiza en un formulario de página completa
                     (target=current), por lo que se retira para evitar acciones
                     invisibles o duplicadas. -->
            </form>
        </field>
    </record>

    <record id="action_madenat_sv_imputation_wizard" model="ir.actions.act_window">
        <field name="name">Registrar rebaja</field>
        <field name="res_model">madenat.sv.imputation.wizard</field>
        <field name="view_mode">form</field>
        <!-- Formulario amplio (mismo asistente) para la tabla de materiales del
             packing list. NO se crea otro wizard ni otra acción. -->
        <field name="target">current</field>
        <field name="view_id" ref="view_madenat_sv_imputation_wizard_form"/>
    </record>
</odoo>
