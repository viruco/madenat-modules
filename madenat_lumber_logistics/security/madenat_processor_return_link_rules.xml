<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Bloque B (CANON/19 §19.11): regla de registro por compañía del
             modelo `madenat.processor.return.link`. Las ACL por grupo NO
             sustituyen reglas de registro. Sin grupo ⇒ regla global. -->
        <record id="rule_madenat_processor_return_link_company" model="ir.rule">
            <field name="name">madenat.processor.return.link: multi-compañía</field>
            <field name="model_id" ref="model_madenat_processor_return_link"/>
            <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id', '=', False)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
