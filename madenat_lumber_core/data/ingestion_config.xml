<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- PARÁMETROS EDITABLES DE INGESTA, S2S Y SECADO (noupdate="1")        -->
    <!-- Declara los 13 parámetros como ir.config_parameter en data XML con  -->
    <!-- noupdate="1", garantizando protección contra sobreescritura en -u.  -->
    <!-- ================================================================== -->
    <data noupdate="1">
        <!-- H1: Mapeo físico→nominal para blanks (reception_parser.py) -->
        <record id="param_blanks_nominal_map" model="ir.config_parameter">
            <field name="key">madenat.blanks_nominal_map</field>
            <field name="value">[[1.0, 1.0], [1.25, 1.25], [1.5, 1.5], [1.5625, 1.5], [2.0, 2.0], [2.0625, 2.0], [2.5, 2.5], [3.0, 3.0]]</field>
        </record>

        <!-- H1: Tolerancia nominal (reception_parser.py) -->
        <record id="param_nominal_tolerance" model="ir.config_parameter">
            <field name="key">madenat.nominal_tolerance</field>
            <field name="value">0.08</field>
        </record>

        <!-- H10+H11: Tabla unificada ancho mm→pulgadas (width_mapping.py + utils_uom.py) -->
        <!-- Fuente: Excel ANCHOS-COMPRA-COL-ROUGH-A-S2S.xlsx — 16 entradas canónicas -->
        <record id="param_width_s2s_map" model="ir.config_parameter">
            <field name="key">madenat.width_s2s_map</field>
            <field name="value">{"75": 2.625, "85": 2.875, "90": 3.125, "95": 3.375, "100": 3.625, "105": 3.875, "110": 3.875, "115": 4.375, "120": 4.375, "125": 4.625, "130": 4.875, "140": 4.875, "145": 5.375, "150": 5.625, "155": 5.875, "170": 170.0}</field>
        </record>

        <!-- H5+H13: Rangos espesor→visual (lumber_reception.py) -->
        <!-- Formato: {"ranges": [[min, max, value, label], ...], "default_format": "{quarters}/4"} -->
        <record id="param_thickness_visual_ranges" model="ir.config_parameter">
            <field name="key">madenat.thickness_visual_ranges</field>
            <field name="value">{"ranges": [[37, 46, 1.5, "6/4"], [22, 29, 1.0, "4/4"], [30, 36, 1.25, "5/4"], [47, 56, 2.0, "8/4"]], "default_format": "{q}/4"}</field>
        </record>

        <!-- H2+H4+H14: Filtros y candados perfil↔subproducto -->
        <!-- Estructura: {"profiles": {"f5085": {"allowed_keywords": [], "forbidden_keywords": ["S2S", "RIP"], "forbidden_in_lock": ["S2S", "RIP"]}, "f1550": {"allowed_keywords": ["S2S"], "forbidden_keywords": [], "forbidden_in_lock": ["ROUGH", "BLANK"]}, "metric": {"allowed_keywords": [], "forbidden_keywords": [], "forbidden_in_lock": []}}} -->
        <record id="param_profile_subproduct_filters" model="ir.config_parameter">
            <field name="key">madenat.profile_subproduct_filters</field>
            <field name="value">{"profiles": {"f5085": {"allowed_keywords": [], "forbidden_keywords": ["S2S", "RIP"], "forbidden_in_lock": ["S2S", "RIP"]}, "f1550": {"allowed_keywords": ["S2S"], "forbidden_keywords": [], "forbidden_in_lock": ["ROUGH", "BLANK"]}, "metric": {"allowed_keywords": [], "forbidden_keywords": [], "forbidden_in_lock": []}}}</field>
        </record>
        <!-- AD-116/AD-117/AD-118: Sobreancho S2S (pulgadas) -->
        <record id="param_s2s_overwidth_inches" model="ir.config_parameter">
            <field name="key">madenat.s2s_overwidth_inches</field>
            <field name="value">0.125</field>
        </record>

        <!-- AD-116/AD-117/AD-118: Comportamiento para anchos fuera de tabla S2S (direct, warning, block) -->
        <record id="param_out_of_table_behavior" model="ir.config_parameter">
            <field name="key">madenat.out_of_table_behavior</field>
            <field name="value">warning</field>
        </record>

        <!-- AD-118: Umbral mínimo en mm para conversión directa sin advertencia (default 170.0) -->
        <record id="param_direct_width_min_mm" model="ir.config_parameter">
            <field name="key">madenat.direct_width_min_mm</field>
            <field name="value">170.0</field>
        </record>

        <!-- AD-116/AD-117/AD-118: Parámetros de secado en horno (temperatura °C y duración h) -->
        <record id="param_drying_temp_min_c" model="ir.config_parameter">
            <field name="key">madenat.drying_temp_min_c</field>
            <field name="value">50.0</field>
        </record>
        <record id="param_drying_temp_max_c" model="ir.config_parameter">
            <field name="key">madenat.drying_temp_max_c</field>
            <field name="value">90.0</field>
        </record>
        <record id="param_drying_duration_min_hours" model="ir.config_parameter">
            <field name="key">madenat.drying_duration_min_hours</field>
            <field name="value">50.0</field>
        </record>
        <record id="param_drying_duration_max_hours" model="ir.config_parameter">
            <field name="key">madenat.drying_duration_max_hours</field>
            <field name="value">80.0</field>
        </record>

        <!-- Semilla editable de keywords de tipo de ingreso -->
        <record id="param_tipo_ingreso_keywords" model="ir.config_parameter">
            <field name="key">madenat.tipo_ingreso_keywords</field>
            <field name="value">{"procesado": ["cepillado", "servicio", "proceso", "maquila"], "granel": ["granel", "volumen total", "a granel", "sin desglose"]}</field>
        </record>
    </data>
</odoo>