<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Bloque 6D (AD-127): Formato de Ingesta Estándar MADENAT (Forestal Andes) -->
        <record id="ingestion_format_packing_estandar_madenat" model="lumber.ingestion.format">
            <field name="profile">standard_madenat</field>
            <field name="active" eval="True"/>
            <field name="sequence">5</field>
            <field name="description">Packing estándar MADENAT (Forestal Andes)</field>
            <field name="source_format">excel</field>
            <field name="thickness_unit_heuristic">always_mm</field>
            <field name="width_unit_heuristic">always_mm</field>
            <field name="length_unit_heuristic">always_m</field>
            <field name="conversion_mode">identity</field>
            <field name="export_rule_outcome">metric</field>
            <field name="thickness_threshold" eval="10.0"/>
            <field name="length_threshold" eval="10.0"/>
            <field name="notes">Plantilla estándar MADENAT basada en el formato de Forestal Andes. Acepta ingesta de proveedores Arauco, JCE, BYC y Fátima normalizados en escuadría métrica con dimensiones en columnas separadas (Espesor mm, Ancho mm, Largo m).</field>
        </record>
    </data>
</odoo>
