<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================== -->
    <!-- BLOQUE 5A — SEED: TABLA DE ESPESORES REALES FÍSICOS (AD-126)        -->
    <!-- Mapeo nominal a espesor real neto en mm (F3 / CANON/17 §9.1)       -->
    <!-- noupdate="1" para que los valores sean editables por el usuario.    -->
    <!-- ================================================================== -->
    <data noupdate="1">
        <!-- 4/4: 1" nominal -> 25.4 mm real -->
        <record id="thickness_real_4_4" model="lumber.thickness.real.map">
            <field name="thickness_visual">4/4</field>
            <field name="thickness_nominal_in">1.0</field>
            <field name="thickness_real_mm">25.4</field>
            <field name="sequence">10</field>
            <field name="active" eval="True"/>
            <field name="notes">Escuadría 4/4 (1 pulgada nominal = 25.4 mm real neto).</field>
        </record>

        <!-- 5/4: 1 1/4" nominal -> 31.75 mm real -->
        <record id="thickness_real_5_4" model="lumber.thickness.real.map">
            <field name="thickness_visual">5/4</field>
            <field name="thickness_nominal_in">1.25</field>
            <field name="thickness_real_mm">31.75</field>
            <field name="sequence">20</field>
            <field name="active" eval="True"/>
            <field name="notes">Escuadría 5/4 (1 1/4 pulgada nominal = 31.75 mm real neto).</field>
        </record>

        <!-- 6/4: 1 1/2" nominal -> 38.1 mm real (F3 Canónica) -->
        <record id="thickness_real_6_4" model="lumber.thickness.real.map">
            <field name="thickness_visual">6/4</field>
            <field name="thickness_nominal_in">1.5</field>
            <field name="thickness_real_mm">38.1</field>
            <field name="sequence">30</field>
            <field name="active" eval="True"/>
            <field name="notes">Escuadría 6/4 canónica (1 1/2 pulgada nominal = 38.1 mm real neto, F3).</field>
        </record>

        <!-- 7/4: 1 3/4" nominal -> 44.45 mm real -->
        <record id="thickness_real_7_4" model="lumber.thickness.real.map">
            <field name="thickness_visual">7/4</field>
            <field name="thickness_nominal_in">1.75</field>
            <field name="thickness_real_mm">44.45</field>
            <field name="sequence">40</field>
            <field name="active" eval="True"/>
            <field name="notes">Escuadría 7/4 (1 3/4 pulgada nominal = 44.45 mm real neto).</field>
        </record>

        <!-- 8/4: 2" nominal -> 50.8 mm real -->
        <record id="thickness_real_8_4" model="lumber.thickness.real.map">
            <field name="thickness_visual">8/4</field>
            <field name="thickness_nominal_in">2.0</field>
            <field name="thickness_real_mm">50.8</field>
            <field name="sequence">50</field>
            <field name="active" eval="True"/>
            <field name="notes">Escuadría 8/4 (2 pulgadas nominales = 50.8 mm real neto).</field>
        </record>
    </data>
</odoo>
