<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="view_madenat_lumber_product_default_list" model="ir.ui.view">
            <field name="name">madenat.lumber.product.default.list</field>
            <field name="model">madenat.lumber.product.default</field>
            <field name="arch" type="xml">
                <list editable="bottom" decoration-muted="not active">
                    <field name="sequence" widget="handle"/>
                    <field name="tipo_ingreso"/>
                    <field name="ingestion_profile"/>
                    <field name="product_id"/>
                    <field name="company_id" optional="show"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_madenat_lumber_product_default_form" model="ir.ui.view">
            <field name="name">madenat.lumber.product.default.form</field>
            <field name="model">madenat.lumber.product.default</field>
            <field name="arch" type="xml">
                <form string="Producto Maestro por Tipo de Ingreso">
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="name"/></h1>
                        </div>
                        <group>
                            <group>
                                <field name="tipo_ingreso"/>
                                <field name="ingestion_profile"/>
                            </group>
                            <group>
                                <field name="product_id"/>
                                <field name="company_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <p class="text-muted">
                            Define qué producto maestro se asigna a cada tipo de ingreso.
                            El producto es fijo y no varía según el contenido del Excel o la guía.
                        </p>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_madenat_lumber_product_default_search" model="ir.ui.view">
            <field name="name">madenat.lumber.product.default.search</field>
            <field name="model">madenat.lumber.product.default</field>
            <field name="arch" type="xml">
                <search>
                    <field name="tipo_ingreso"/>
                    <field name="ingestion_profile"/>
                    <field name="product_id"/>
                    <filter name="active" string="Activos" domain="[('active','=',True)]"/>
                    <filter name="inactive" string="Todos" domain="[]"/>
                </search>
            </field>
        </record>

        <record id="action_madenat_lumber_product_default" model="ir.actions.act_window">
            <field name="name">Productos Maestros por Tipo de Ingreso</field>
            <field name="res_model">madenat.lumber.product.default</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea la primera regla de producto maestro
                </p>
                <p>
                    Asocia cada tipo de ingreso (bruta / procesado) a un producto
                    maestro fijo, sin depender del contenido del Excel.
                </p>
            </field>
        </record>

        <menuitem id="menu_madenat_lumber_product_default"
                  name="Productos Maestros por Tipo"
                  parent="menu_lumber_ingestion_config_root"
                  action="action_madenat_lumber_product_default"
                  sequence="45"
                  groups="madenat_lumber_core.group_lumber_config_manager,madenat_lumber_core.group_madenat_jefatura_operaciones"/>

    </data>
</odoo>
