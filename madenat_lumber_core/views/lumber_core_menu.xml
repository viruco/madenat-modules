<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACCIONES PROPIAS DE CORE                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACCIÓN 567 — Consola de Recepciones Principal                   -->
        <!-- Abre agrupada por OC (purchase_order) por defecto para lectura  -->
        <!-- rápida. Excluye canceladas del dominio base.                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="action_lumber_reception_pending" model="ir.actions.act_window">
            <field name="name">Consola de Recepciones</field>
            <field name="res_model">lumber.reception</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="madenat_lumber_core.view_lumber_reception_list"/>
            <field name="search_view_id" ref="madenat_lumber_core.view_lumber_reception_search"/>
            <field name="domain">[('state', 'not in', ['cancelled'])]</field>
            <field name="context">{'search_default_group_by_purchase_order': 1, 'search_default_order_by_date': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Consola de Recepciones MADENAT</p>
                <p>Visualice, filtre y gestione todas las recepciones de madera bruta agrupadas por OC.</p>
            </field>
        </record>

        <record id="action_lumber_reception_raw_only" model="ir.actions.act_window">
            <field name="name">📥 Ingreso de Guías Dentro de Recepción</field>
            <field name="res_model">lumber.reception</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_lumber_reception_list"/>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Crea la primera recepción de madera bruta</p>
            </field>
        </record>

        <record id="action_guia_processing_list" model="ir.actions.act_window">
            <field name="name">Guías Procesadas (Servicios)</field>
            <field name="res_model">madenat.guia.processing</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_madenat_guia_processing_list"/>
            <field name="search_view_id" ref="view_madenat_guia_processing_search"/>
            <field name="domain">[('tipo_recepcion', '!=', 'raw'), ('state', 'not in', ['cancelled'])]</field>
            <field name="context">{'search_default_order_by_date': 1, 'default_tipo_recepcion': 'service'}</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- P2-5 — TRAZABILIDAD 360° (madenat.audit.log, solo lectura)      -->
        <!-- Vistas profesionales readonly, sin botones de negocio, sin       -->
        <!-- chatter (el modelo no hereda mail.thread). El modelo no tiene    -->
        <!-- FKs directas a stock.lot / lumber.container /                   -->
        <!-- lumber.export.shipment / stock.picking / operación SV ni         -->
        <!-- imputación SV, por lo que NO se ofrecen filtros por esos objetos.-->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_madenat_audit_log_list" model="ir.ui.view">
            <field name="name">madenat.audit.log.list</field>
            <field name="model">madenat.audit.log</field>
            <field name="arch" type="xml">
                <list string="Trazabilidad 360°" create="false" edit="false" delete="false">
                    <field name="timestamp"/>
                    <field name="action_type"/>
                    <field name="user_id"/>
                    <field name="reception_id"/>
                    <field name="guia_processing_id"/>
                    <field name="batch_id"/>
                    <field name="description"/>
                    <field name="month" optional="hide"/>
                </list>
            </field>
        </record>

        <record id="view_madenat_audit_log_form" model="ir.ui.view">
            <field name="name">madenat.audit.log.form</field>
            <field name="model">madenat.audit.log</field>
            <field name="arch" type="xml">
                <form string="Trazabilidad 360°" create="false" edit="false" delete="false">
                    <sheet>
                        <group>
                            <group string="Evento">
                                <field name="timestamp" readonly="1"/>
                                <field name="action_type" readonly="1"/>
                                <field name="user_id" readonly="1"/>
                                <field name="month" readonly="1"/>
                            </group>
                            <group string="Referencias">
                                <field name="batch_id" readonly="1"/>
                                <field name="reception_id" readonly="1"/>
                                <field name="guia_processing_id" readonly="1"/>
                            </group>
                        </group>
                        <group string="Descripción">
                            <field name="description" nolabel="1" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Evidencia Firmada">
                                <group>
                                    <field name="audit_hash" readonly="1"/>
                                </group>
                                <field name="audit_snapshot" readonly="1"/>
                            </page>
                            <page string="Metadatos Técnicos">
                                <group>
                                    <field name="create_uid" readonly="1"/>
                                    <field name="create_date" readonly="1"/>
                                    <field name="write_uid" readonly="1"/>
                                    <field name="write_date" readonly="1"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="view_madenat_audit_log_search" model="ir.ui.view">
            <field name="name">madenat.audit.log.search</field>
            <field name="model">madenat.audit.log</field>
            <field name="arch" type="xml">
                <search string="Trazabilidad 360°">
                    <field name="reception_id"/>
                    <field name="guia_processing_id"/>
                    <field name="user_id"/>
                    <field name="batch_id"/>
                    <field name="description"/>
                    <separator/>
                    <filter name="filter_creation" string="Creación Producto" domain="[('action_type', '=', 'creation')]"/>
                    <filter name="filter_omission" string="Omisión Producto" domain="[('action_type', '=', 'omission')]"/>
                    <filter name="filter_lot_creation" string="Creación Lote" domain="[('action_type', '=', 'lot_creation')]"/>
                    <filter name="filter_lot_update" string="Actualización Lote" domain="[('action_type', '=', 'lot_update')]"/>
                    <filter name="filter_consumption" string="Salida a Proceso" domain="[('action_type', '=', 'consumption')]"/>
                    <filter name="filter_validation_signature" string="Firma de Validación" domain="[('action_type', '=', 'validation_signature')]"/>
                    <filter name="filter_reclassification" string="Reclasificación Tipo de Ingreso" domain="[('action_type', '=', 'reclassification')]"/>
                    <filter name="filter_volume_operational_update" string="Actualización Volumen Operativo" domain="[('action_type', '=', 'volume_operational_update')]"/>
                    <filter name="filter_conciliation_manual_confirm" string="Confirmación Manual de Conciliación" domain="[('action_type', '=', 'conciliation_manual_confirm')]"/>
                    <filter name="filter_sv_operation" string="Operación de Etiqueta SV" domain="[('action_type', '=', 'sv_operation')]"/>
                    <filter name="filter_guia_delete_blocked" string="Eliminación de Guía Bloqueada" domain="[('action_type', '=', 'guia_delete_blocked')]"/>
                    <filter name="filter_guia_delete_permanent" string="Eliminación Definitiva de Guía" domain="[('action_type', '=', 'guia_delete_permanent')]"/>
                    <filter name="filter_guia_purged" string="Purga Controlada de Guía" domain="[('action_type', '=', 'guia_purged')]"/>
                    <filter name="filter_rebaja" string="Rebaja de Contenedor" domain="[('action_type', '=', 'rebaja')]"/>
                    <filter name="filter_rebaja_reverse" string="Reversa de Rebaja" domain="[('action_type', '=', 'rebaja_reverse')]"/>
                    <filter name="filter_deviation" string="Desviación Aceptada" domain="[('action_type', '=', 'deviation')]"/>
                    <filter name="filter_processor_shipment" string="Envío a Procesador" domain="[('action_type', '=', 'processor_shipment')]"/>
                    <filter name="filter_imputation" string="Imputación Documental SV" domain="[('action_type', '=', 'imputation')]"/>
                    <filter name="filter_imputation_reverse" string="Reversa de Imputación Documental SV" domain="[('action_type', '=', 'imputation_reverse')]"/>
                    <separator/>
                    <filter name="filter_timestamp" string="Rango de Fecha" date="timestamp"/>
                    <group expand="0" string="Agrupar Por">
                        <filter name="group_month" string="Mes" context="{'group_by': 'month'}"/>
                        <filter name="group_action_type" string="Tipo de Acción" context="{'group_by': 'action_type'}"/>
                        <filter name="group_user" string="Usuario" context="{'group_by': 'user_id'}"/>
                        <filter name="group_reception" string="Recepción" context="{'group_by': 'reception_id'}"/>
                        <filter name="group_guia_processing" string="Guía de Procesamiento" context="{'group_by': 'guia_processing_id'}"/>
                    </group>
                </search>
            </field>
        </record>


        <record id="action_madenat_audit_logs" model="ir.actions.act_window">
            <field name="name">Trazabilidad 360°</field>
            <field name="res_model">madenat.audit.log</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_madenat_audit_log_list"/>
            <field name="search_view_id" ref="view_madenat_audit_log_search"/>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">Sin registros de auditoría</p>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACCIONES MIGRADAS DESDE REPORTS (inventory adjustments)        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="view_madenat_clean_inventory_tree" model="ir.ui.view">
            <field name="name">madenat.clean.inventory.list</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <list string="Ajustes Físicos" js_class="inventory_report_list" editable="bottom" create="1" edit="1">
                    <field name="etiqueta_limpia" string="Etiqueta Lote"/>
                    <field name="product_id" string="Producto" readonly="id != False" context="{'display_default_code': False}"/>
                    <field name="subproducto_id" string="Subproducto" optional="show"/>
                    <field name="location_id" string="Patio / Ubicación" readonly="id != False"/>
                    <field name="reception_name" string="N° de Guía" decoration-info="1" readonly="1" optional="show"/>
                    <field name="quantity" string="M³ (Sistema)" readonly="1"/>
                    <field name="inventory_quantity" string="M³ Físico (Escriba su Conteo aquí)"/>
                    <field name="inventory_diff_quantity" string="Diferencia" readonly="1" decoration-danger="inventory_diff_quantity &lt; 0" decoration-success="inventory_diff_quantity &gt; 0"/>
                    <field name="product_uom_id" string="UdM" readonly="1"/>
                    <field name="reception_date" string="Fecha Guía" widget="date" optional="hide" readonly="1"/>
                </list>
            </field>
        </record>

        <record id="action_madenat_inventory_adjustments" model="ir.actions.act_window">
            <field name="name">⚖️ Ajustes Físicos</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_madenat_clean_inventory_tree"/>
            <field name="context">{'inventory_mode': True}</field>
            <field name="domain">[('location_id.usage', '=', 'internal')]</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACCIÓN MIGRADA DESDE REPORTS (config patios)                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <record id="action_madenat_patios_recepcion" model="ir.actions.act_window">
            <field name="name">Patios de Recepción</field>
            <field name="res_model">stock.location</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="madenat_lumber_core.view_location_patio_tree"/>
            <field name="search_view_id" ref="madenat_lumber_core.view_location_search_madenat_patio"/>
            <field name="domain">[('is_patio', '=', True)]</field>
            <field name="context">{'default_usage': 'internal', 'default_is_patio': True, 'search_default_filter_is_patio': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear un nuevo patio de recepción o almacenamiento de madera
                </p>
                <p>
                    Configure los patios asignables a recepciones de compra y procesamiento.
                </p>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ROOT ÚNICO MADENAT LUMBER — madenat_lumber_core ES EL DUEÑO   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_madenat_root"
                  name="MADENAT Lumber"
                  web_icon="madenat_lumber_core,static/description/icon.png"
                  sequence="1"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RAMAS DE PRIMER NIVEL (ARQUITECTURA BASE EN CORE)              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- FASE 2 — 488 (Consola de Compras Madera) como entrada principal del módulo.
             Reemplaza funcionalmente a 744 (Dashboard Operaciones) retirado del flujo. -->
        <menuitem id="menu_ops_main"
                  name="📦 Operaciones"
                  parent="menu_madenat_root"
                  sequence="10"/>

        <!-- P2-3: Carpeta vacía "🚢 Exportaciones" (id 442) inactivada.
             No se toca Embarques, Contenedores, Consolidación ni Rebaja por
             Nave (viven bajo Logística Exportación). Solo metadato de menú. -->
        <menuitem id="menu_export_main"
                  name="🚢 Exportaciones"
                  parent="menu_madenat_root"
                  sequence="20"
                  active="0"/>

        <menuitem id="menu_madenat_reports_main"
                  name="📊 Reportes y Listados"
                  parent="menu_madenat_root"
                  sequence="45"/>

        <menuitem id="menu_finance_main"
                  name="💰 Costeo y Finanzas"
                  parent="menu_madenat_root"
                  sequence="30"/>

        <menuitem id="menu_audit_main"
                  name="⚖️ Auditoría"
                  parent="menu_madenat_root"
                  sequence="40"/>

        <menuitem id="menu_madenat_config_root"
                  name="Configuración"
                  parent="menu_madenat_root"
                  sequence="100"
                  groups="base.group_system,group_lumber_config_manager"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- RAMAS DE SEGUNDO NIVEL — ESTRUCTURALES COMPARTIDAS             -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- ▸ Operaciones → Abastecimiento -->
        <menuitem id="menu_ops_supply"
                  name="Abastecimiento"
                  parent="menu_ops_main"
                  sequence="10"/>

        <!-- ▸ Operaciones → Abastecimiento → Gestión de Entradas -->
        <menuitem id="menu_ops_reception_cat"
                  name="📥 Gestión de Entradas"
                  parent="menu_ops_supply"
                  sequence="20"/>

        <!-- ▸ Operaciones → Control de Lotes -->
        <menuitem id="menu_ops_inventory"
                  name="Control de Lotes"
                  parent="menu_ops_main"
                  sequence="20"/>

        <!-- ▸ Costeo y Finanzas → Centro de Costeo -->
        <menuitem id="menu_finance_costing"
                  name="Centro de Costeo"
                  parent="menu_finance_main"
                  sequence="10"/>

        <!-- ▸ Costeo y Finanzas → Pagos y Facturación -->
        <!-- P2-3: Carpeta vacía "Pagos y Facturación" (id 451) inactivada.
             No se toca Costeo, Facturación, Pagos, Contabilidad ni menús
             financieros realmente funcionales. Solo metadato de menú. -->
        <menuitem id="menu_finance_payments"
                  name="Pagos y Facturación"
                  parent="menu_finance_main"
                  sequence="20"
                  active="0"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MENÚS PROPIOS DE CORE REPARENTADOS CORRECTAMENTE               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_lumber_reception_pending"
                  name="📥 Ingreso de Guías"
                  parent="menu_ops_reception_cat"
                  action="action_lumber_reception_pending"
                  sequence="10"
                  groups="group_madenat_jefatura_operaciones"/>

        <menuitem id="menu_lumber_reception_pending_stock"
                  name="⏳ Pendientes de Stock"
                  parent="menu_ops_reception_cat"
                  action="action_lumber_reception_pending_stock"
                  sequence="12"
                  groups="group_madenat_jefatura_operaciones"/>

        <menuitem id="menu_lumber_reception_kanban"
                  name="📋 Tablero de Recepciones"
                  parent="menu_ops_reception_cat"
                  action="action_lumber_reception_kanban"
                  sequence="5"
                  groups="group_madenat_jefatura_operaciones"/>

        <menuitem id="menu_guia_processing_root"
                  name="🏭 Guías Procesadas"
                  parent="menu_ops_reception_cat"
                  sequence="20"
                  groups="group_madenat_jefatura_operaciones"/>

        <menuitem id="menu_lumber_reception"
                  name="📋 Historial de Ingresos"
                  parent="menu_ops_reception_cat"
                  action="action_lumber_reception_raw_only"
                  sequence="30"
                  groups="group_madenat_jefatura_operaciones"/>

        <!-- ▸ Submenú de Guías Procesadas -->
        <menuitem id="menu_guia_processing_list"
                  name="Guías Procesadas"
                  parent="menu_guia_processing_root"
                  action="action_guia_processing_list"
                  sequence="10"
                  groups="group_madenat_jefatura_operaciones"/>

        <!-- ▸ Auditoría → Trazabilidad 360° (P2-5)
             Consulta de control/auditoría readonly. Grupos autorizados:
             Jefatura de Stock, Auditoría MADENAT, Jefatura de Operaciones y
             Gerencia. NO se incluye Operaciones ni stock.group_user básico. -->
        <menuitem id="menu_madenat_audit"
                  name="Trazabilidad 360°"
                  parent="menu_audit_main"
                  action="action_madenat_audit_logs"
                  sequence="10"
                  groups="stock.group_stock_manager,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_jefatura_operaciones,madenat_lumber_core.group_madenat_gerencia"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- INVENTORY ADJUSTMENTS (migrado desde reports)                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_madenat_inventory_adjustments"
                  name="⚖️ Ajustes Físicos (Stock)"
                  parent="menu_ops_inventory"
                  action="action_madenat_inventory_adjustments"
                  sequence="10"
                  groups="stock.group_stock_manager"/>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- CONFIGURACIÓN (migrado desde reports)                          -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <menuitem id="menu_madenat_config_patios"
                  name="🏗️ Patios de Recepción"
                  parent="menu_madenat_config_root"
                  action="action_madenat_patios_recepcion"
                  sequence="10"
                  groups="stock.group_stock_manager,base.group_system,group_lumber_config_manager"/>

        <menuitem id="menu_madenat_config_subproducto"
                  name="🏷️ Subproductos y Grados"
                  parent="menu_madenat_config_root"
                  action="madenat_lumber_core.action_madenat_subproducto_config"
                  sequence="20"
                  groups="stock.group_stock_manager,base.group_system,group_lumber_config_manager"/>

    </data>
</odoo>