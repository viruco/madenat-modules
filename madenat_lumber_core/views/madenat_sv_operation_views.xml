<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- PROGRAMA SV — Historial de operaciones de etiquetas SV          -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="view_madenat_sv_operation_list" model="ir.ui.view">
        <field name="name">madenat.sv.operation.list</field>
        <field name="model">madenat.sv.operation</field>
        <field name="arch" type="xml">
            <list string="Operaciones de etiqueta SV" create="false">
                <!-- Fase 2 (AD-80): reversa visible SOLO en la rebaja aplicada
                     y aún no reversada. La guarda real (segunda reversa
                     bloqueada) vive en el ledger, no en la vista. -->
                <button name="action_open_reverse_wizard" type="object"
                        string="Reversar rebaja" class="btn-link"
                        invisible="action_type != 'rebaja' or state != 'applied' or reversed_operation_id"/>
                <field name="name"/>
                <field name="execution_date"/>
                <field name="lot_id"/>
                <field name="guia_processing_id"/>
                <field name="action_type" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'applied'"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'reversed'"
                       decoration-muted="state == 'rejected'"/>
                <field name="prior_label" optional="hide"/>
                <field name="new_label" optional="hide"/>
                <field name="prior_volume_m3" optional="show" sum="Volumen previo"/>
                <field name="new_volume_m3" optional="show" sum="Volumen nuevo"/>
                <field name="volume_diff_m3" optional="show"/>
                <field name="rebaja_volume_m3" optional="show" sum="Rebajado"/>
                <field name="rebaja_pieces" optional="hide"/>
                <field name="origin_operation_id" optional="hide"/>
                <field name="destination_reference" optional="hide"/>
                <field name="executed_by_id" optional="show"/>
                <field name="approved_by_id" optional="hide"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_madenat_sv_operation_search" model="ir.ui.view">
        <field name="name">madenat.sv.operation.search</field>
        <field name="model">madenat.sv.operation</field>
        <field name="arch" type="xml">
            <search string="Operaciones SV">
                <field name="lot_id"/>
                <field name="guia_processing_id"/>
                <field name="name"/>
                <field name="reason"/>
                <filter name="filter_applied" string="Aplicadas"
                        domain="[('state', '=', 'applied')]"/>
                <filter name="filter_draft" string="Pendientes"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="filter_rebaja" string="Rebajas"
                        domain="[('action_type', '=', 'rebaja')]"/>
                <filter name="filter_regularize" string="Regularizaciones"
                        domain="[('action_type', '=', 'regularize_volume')]"/>
                <separator/>
                <group expand="0" string="Agrupar por">
                    <filter name="group_by_action_type" string="Tipo"
                            context="{'group_by': 'action_type'}"/>
                    <filter name="group_by_state" string="Estado"
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_lot" string="Etiqueta SV"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_by_guia" string="Guía"
                            context="{'group_by': 'guia_processing_id'}"/>
                    <filter name="group_by_user" string="Ejecutada por"
                            context="{'group_by': 'executed_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_madenat_sv_operation" model="ir.actions.act_window">
        <field name="name">Historial de etiquetas SV</field>
        <field name="res_model">madenat.sv.operation</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_madenat_sv_operation_list"/>
        <field name="search_view_id" ref="view_madenat_sv_operation_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Sin operaciones de etiquetas SV registradas
            </p>
            <p>Las operaciones se ejecutan desde la etiqueta SV o su Guía
               (Modificar etiqueta, Regularizar volumen, Rebajar, Reversar).</p>
        </field>
    </record>

    <menuitem id="menu_madenat_sv_root"
              name="🏷️ Etiquetas SV"
              parent="menu_ops_main"
              sequence="30"/>
    <menuitem id="menu_madenat_sv_operation"
              name="Historial de etiquetas SV"
              parent="menu_madenat_sv_root"
              action="action_madenat_sv_operation"
              sequence="10"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- F3.1 — LISTADO DE ETIQUETAS SV (Lotes Volumen)                  -->
    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- Vista simple y directa de las etiquetas SV generadas por las   -->
    <!-- Guías por Volumen: etiqueta, producto, volumen inicial, saldo,  -->
    <!-- guía de origen, patio/ubicación y estado. Al abrir una fila se  -->
    <!-- accede al formulario del lote con las acciones SV existentes.   -->
    <record id="view_madenat_stock_lot_sv_list" model="ir.ui.view">
        <field name="name">stock.lot.sv.list</field>
        <field name="model">stock.lot</field>
        <field name="arch" type="xml">
            <list string="Etiquetas SV (Ingreso por Volumen)" create="false">
                <field name="name" string="Etiqueta SV" decoration-bf="1"/>
                <field name="product_id" string="Producto"/>
                <field name="volume_purchase_m3" string="Volumen inicial (m³)" sum="Volumen inicial"/>
                <field name="sv_available_m3" string="Saldo disponible (m³)" sum="Saldo disponible"/>
                <field name="volume_source_guia_id" string="Guía de origen"/>
                <field name="location_id" string="Patio/Ubicación"/>
                <field name="technical_validation" string="Estado" widget="badge"
                       decoration-success="technical_validation == 'approved'"
                       decoration-warning="technical_validation == 'pending'"/>
            </list>
        </field>
    </record>

    <record id="action_madenat_sv_lots" model="ir.actions.act_window">
        <field name="name">Etiquetas SV (Ingreso por Volumen)</field>
        <field name="res_model">stock.lot</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_madenat_stock_lot_sv_list"/>
        <field name="domain">[('lot_flow_type', '=', 'volume')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aún no hay etiquetas SV generadas
            </p>
            <p>Se generan automáticamente al validar una Guía por Volumen
               (una etiqueta por cada línea elegible).</p>
        </field>
    </record>

    <menuitem id="menu_madenat_sv_lots"
              name="Etiquetas SV"
              parent="menu_madenat_sv_root"
              action="action_madenat_sv_lots"
              sequence="5"
              groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad"/>

    <!-- ═══════════════════════════════════════════════════════════════ -->
    <!-- ACCIONES SV EN LA ETIQUETA (stock.lot) Y EN LA GUÍA             -->
    <!-- ═══════════════════════════════════════════════════════════════ -->

    <record id="view_stock_lot_form_madenat_sv" model="ir.ui.view">
        <field name="name">stock.lot.form.madenat.sv</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="view_stock_lot_form_madenat"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_sv_rename" type="object"
                        string="Modificar etiqueta SV" class="btn-secondary"
                        invisible="lot_flow_type != 'volume'"/>
                <button name="action_sv_regularize_volume" type="object"
                        string="Regularizar volumen" class="btn-secondary"
                        invisible="lot_flow_type != 'volume'"/>
                <button name="action_sv_rebaja" type="object"
                        string="Rebajar etiqueta" class="btn-secondary"
                        invisible="lot_flow_type != 'volume'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="🏷️ Etiqueta SV" name="sv_label"
                      invisible="lot_flow_type != 'volume'">
                    <group>
                        <group string="Identidad">
                            <field name="volume_source_guia_id"/>
                            <field name="sv_documentary_volume_m3"/>
                            <field name="sv_documentary_warning" invisible="1"/>
                        </group>
                        <group string="Saldo">
                            <field name="sv_original_volume_m3"/>
                            <field name="sv_regularized_baseline_m3"/>
                            <field name="sv_rebajado_m3"/>
                            <field name="sv_available_m3"/>
                            <field name="sv_pieces_enabled"/>
                            <field name="sv_available_pieces"
                                   invisible="not sv_pieces_enabled"/>
                        </group>
                    </group>
                    <div class="alert alert-warning" role="alert"
                         invisible="not sv_documentary_warning">
                        El volumen oficial documental de la Guía difiere del
                        volumen original del lote, o la etiqueta usa el
                        piezas=1 técnico. Use "Regularizar volumen" para dejar
                        constancia documental.
                    </div>
                    <group>
                        <button name="action_open_sv_history" type="object"
                                string="Ver historial SV" class="btn-link"
                                icon="fa-history"/>
                    </group>
                    <field name="sv_operation_ids" readonly="1">
                        <list create="false" edit="false" delete="false">
                            <field name="name"/>
                            <field name="execution_date"/>
                            <field name="action_type"/>
                            <field name="state" widget="badge"/>
                            <field name="prior_volume_m3"/>
                            <field name="new_volume_m3"/>
                            <field name="rebaja_volume_m3"/>
                            <field name="reason"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_madenat_guia_processing_form_sv" model="ir.ui.view">
        <field name="name">madenat.guia.processing.form.sv</field>
        <field name="model">madenat.guia.processing</field>
        <field name="inherit_id" ref="view_madenat_guia_processing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Fase 2 (AD-80): acciones SV aprobadas en el formulario de
                     la Guía. Todas delegan en los métodos canónicos de la
                     Guía (wizard + ledger append-only); ninguna escribe
                     directamente stock.lot.name, volumen ni saldo. -->
                <button name="action_sv_rename" type="object"
                        string="Modificar etiqueta SV" class="btn-secondary"
                        invisible="tipo_recepcion != 'granel' or not volume_lot_id"
                        groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad"/>
                <button name="action_sv_regularize_volume" type="object"
                        string="Regularizar volumen" class="btn-secondary"
                        invisible="tipo_recepcion != 'granel' or not volume_lot_id"
                        groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad"/>
                <button name="action_sv_rebaja" type="object"
                        string="Rebajar etiqueta" class="btn-secondary"
                        invisible="tipo_recepcion != 'granel' or not volume_lot_id"
                        groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad"/>
                <button name="action_open_sv_history" type="object"
                        string="🏷️ Historial SV" class="btn-secondary"
                        groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="🏷️ Etiqueta SV" invisible="tipo_recepcion != 'granel'">
                    <field name="volume_lot_id" readonly="1"/>
                    <field name="sv_operation_count" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
