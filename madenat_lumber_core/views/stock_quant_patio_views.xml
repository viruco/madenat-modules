<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BÚSQUEDA: INVENTARIO POR PATIO (stock.quant)                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="view_stock_quant_patio_search" model="ir.ui.view">
            <field name="name">stock.quant.patio.search</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <search string="Inventario por Patio">
                    <field name="location_id" string="Patio"/>
                    <field name="supplier_id" string="Proveedor"/>
                    <field name="product_id" string="Producto"/>
                    <field name="lot_id" string="Lote / Etiqueta"/>
                    <field name="guia_number" string="N° Guía"/>

                    <filter string="Patio de Servicio" name="filter_service" domain="[('location_id.patio_type', '=', 'service')]"/>
                    <filter string="Patio de Puerto" name="filter_port" domain="[('location_id.patio_type', '=', 'port')]"/>
                    <separator/>

                    <group expand="1" string="Agrupar por">
                        <filter string="Patio" name="group_by_location" context="{'group_by': 'location_id'}"/>
                        <filter string="Proveedor" name="group_by_supplier" context="{'group_by': 'supplier_id'}"/>
                        <filter string="Producto" name="group_by_product" context="{'group_by': 'product_id'}"/>
                        <filter string="Tipo de Patio" name="group_by_patio_type" context="{'group_by': 'patio_type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- LISTA: INVENTARIO POR PATIO (Solo lectura, sin edición)        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="view_stock_quant_patio_list" model="ir.ui.view">
            <field name="name">stock.quant.patio.list</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <list string="Inventario por Patio" create="0" delete="0" edit="0">
                    <field name="location_id" string="Patio"/>
                    <field name="patio_type" string="Tipo de Patio"/>
                    <field name="supplier_id" string="Proveedor"/>
                    <field name="product_id" string="Producto"/>
                    <field name="lot_id" string="Etiqueta / Lote"/>
                    <field name="guia_number" string="N° Guía"/>
                    <field name="lot_piezas" string="Piezas" sum="Total Piezas"/>
                    <field name="quantity" string="Volumen Stock (m³)" sum="Total Volumen Stock m³"/>
                    <field name="vol_nominal_m3" string="Vol. Compra (m³)" sum="Total Vol. Compra m³" optional="show"/>
                </list>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- PIVOTE: INVENTARIO POR PATIO                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="view_stock_quant_patio_pivot" model="ir.ui.view">
            <field name="name">stock.quant.patio.pivot</field>
            <field name="model">stock.quant</field>
            <field name="arch" type="xml">
                <pivot string="Inventario por Patio" display_quantity="0">
                    <field name="location_id" type="row"/>
                    <field name="supplier_id" type="row"/>
                    <field name="product_id" type="row"/>
                    <field name="lot_piezas" type="measure" string="Piezas"/>
                    <field name="quantity" type="measure" string="Volumen Stock (m³)"/>
                </pivot>
            </field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- ACCIÓN: INVENTARIO POR PATIO                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <record id="action_madenat_inventario_por_patio" model="ir.actions.act_window">
            <field name="name">Inventario por Patio</field>
            <field name="res_model">stock.quant</field>
            <field name="view_mode">list,pivot</field>
            <field name="view_id" ref="view_stock_quant_patio_list"/>
            <field name="search_view_id" ref="view_stock_quant_patio_search"/>
            <field name="domain">[('location_id.is_patio', '=', True), ('quantity', '>', 0)]</field>
            <field name="context">{'search_default_group_by_location': 1, 'search_default_group_by_supplier': 1, 'search_default_group_by_product': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Inventario de Madera por Patio
                </p>
                <p>
                    Visualice el inventario físico en patios clasificados (Servicio y Puerto),
                    agrupado por patio, proveedor y producto, con piezas y volumen nominal de compra.
                </p>
            </field>
        </record>

        <record id="action_madenat_inventario_por_patio_view_list" model="ir.actions.act_window.view">
            <field name="sequence" eval="1"/>
            <field name="view_mode">list</field>
            <field name="view_id" ref="view_stock_quant_patio_list"/>
            <field name="act_window_id" ref="action_madenat_inventario_por_patio"/>
        </record>

        <record id="action_madenat_inventario_por_patio_view_pivot" model="ir.actions.act_window.view">
            <field name="sequence" eval="2"/>
            <field name="view_mode">pivot</field>
            <field name="view_id" ref="view_stock_quant_patio_pivot"/>
            <field name="act_window_id" ref="action_madenat_inventario_por_patio"/>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MENÚ: INVENTARIO POR PATIO                                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <menuitem id="menu_madenat_inventario_patio"
                  name="🌲 Inventario por Patio"
                  parent="madenat_lumber_core.menu_ops_inventory"
                  action="action_madenat_inventario_por_patio"
                  sequence="5"
                  groups="madenat_lumber_core.group_madenat_operaciones,madenat_lumber_core.group_madenat_auditoria,madenat_lumber_core.group_madenat_contabilidad,stock.group_stock_manager"/>

    </data>
</odoo>
