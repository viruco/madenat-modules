<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_madenat_guia_processing_documental_correction_wizard_form" model="ir.ui.view">
        <field name="name">madenat.guia.processing.documental.correction.wizard.form</field>
        <field name="model">madenat.guia.processing.documental.correction.wizard</field>
        <field name="arch" type="xml">
            <form string="Corrección documental (CDP-V1)">
                <group>
                    <field name="guia_processing_id" options="{'no_open': True}"/>
                    <field name="state_name"/>
                </group>
                <div class="alert alert-info" role="alert">
                    <field name="warning_text" nolabel="1"/>
                </div>
                <div class="alert alert-warning" role="alert"
                     invisible="not physical_history_text">
                    <field name="physical_history_text" nolabel="1"/>
                </div>
                <group string="Datos documentales">
                    <field name="date_emission"/>
                    <field name="oc_reference_raw"/>
                    <field name="carrier_id" options="{'no_create': True}"/>
                    <field name="assignment_location_id"
                           options="{'no_create': True}"/>
                </group>
                <group string="Totales documentales declarados">
                    <field name="vol_comercial_pdf"/>
                    <field name="packing_volume_declared_m3"/>
                    <field name="packing_pieces_declared"/>
                    <field name="packing_package_count_declared"/>
                    <field name="total_paquetes"/>
                    <field name="total_lotes_unicos"/>
                </group>
                <group string="Nueva versión de adjuntos (opcional; conserva la anterior)">
                    <field name="new_pdf_file" filename="new_pdf_filename"/>
                    <field name="new_pdf_filename" invisible="1"/>
                    <field name="new_excel_file" filename="new_excel_filename"/>
                    <field name="new_excel_filename" invisible="1"/>
                </group>
                <field name="notes"
                       placeholder="Observaciones documentales"/>
                <field name="reason"
                       placeholder="Motivo de la corrección (obligatorio)"/>
                <footer>
                    <button name="action_confirm"
                            string="Aplicar corrección documental"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_madenat_guia_processing_documental_correction_wizard"
            model="ir.actions.act_window">
        <field name="name">Corrección documental (CDP-V1)</field>
        <field name="res_model">madenat.guia.processing.documental.correction.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_madenat_guia_processing_documental_correction_wizard_form"/>
    </record>
</odoo>
