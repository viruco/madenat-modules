<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_madenat_ingestion_column_profile_list" model="ir.ui.view">
        <field name="name">madenat.ingestion.column.profile.list</field>
        <field name="model">madenat.ingestion.column.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_madenat_ingestion_column_profile_form" model="ir.ui.view">
        <field name="name">madenat.ingestion.column.profile.form</field>
        <field name="model">madenat.ingestion.column.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <group string="Notas">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
