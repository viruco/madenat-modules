<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_madenat_lumber_intake_wizard_form" model="ir.ui.view">
        <field name="name">madenat.lumber.intake.wizard.form</field>
        <field name="model">madenat.lumber.intake.wizard</field>
        <field name="arch" type="xml">
            <form string="Ingreso de Madera">
                <header>
                    <button
                        name="action_preview_document"
                        type="object"
                        string="Leer documento"
                        class="btn-secondary"
                        invisible="state not in ('draft', 'error')" />
                    <button
                        name="action_route_document"
                        type="object"
                        string="Continuar ingreso"
                        class="btn-primary"
                        invisible="state == 'routed'" />
                    <button
                        name="action_open_intake_target"
                        type="object"
                        string="Abrir registro creado"
                        class="btn-primary"
                        invisible="target_res_id == 0" />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>

                <sheet>
                    <div class="alert alert-info" role="alert">
                        <field name="requirements_info" readonly="1" nolabel="1"/>
                    </div>

                    <group string="Modalidad de Ingesta">
                        <field name="intake_modality" widget="radio"/>
                        <div class="text-muted" invisible="intake_modality != 'normal'">
                            Ingreso normal: PDF/Guía y Excel obligatorios.
                        </div>
                        <div class="text-muted" invisible="intake_modality != 'volume'">
                            Ingreso por Volúmenes: puede adjuntar PDF, Excel o ambos.
                            Si adjunta ambos, se realiza conciliación documental.
                        </div>
                    </group>

                    <group string="Destino del ingreso">
                        <group>
                            <field name="tipo_ingreso" invisible="1"/>
                            <field
                                name="ingestion_profile"
                                invisible="intake_modality == 'volume'" />
                            <field
                                name="confirm_profile_mismatch"
                                invisible="not profile_warning_message and not confirm_profile_mismatch" />
                            <field
                                name="classification_result"
                                string="Clasificación documental detectada"
                                invisible="intake_modality != 'normal' or not classification_result" />
                            <field name="has_reading_warning" invisible="1" />
                            <div class="text-warning fw-bold" invisible="not has_reading_warning">
                                <i class="fa fa-exclamation-triangle me-1" title="Advertencia de lectura"/>
                                Lectura con advertencia — revise el detalle antes de continuar
                            </div>
                            <field
                                name="assignment_location_id" />
                            <field
                                name="tipo_detalle_granel"
                                invisible="intake_modality != 'volume'" />
                        </group>
                    </group>

                    <group string="Documentos">
                        <group>
                            <field name="excel_file" filename="excel_filename"
                                   required="intake_modality == 'normal'" />
                            <field name="excel_filename" />
                            <field name="pdf_file" filename="pdf_filename" required="intake_modality == 'normal'" />
                            <field name="pdf_filename" />
                        </group>
                    </group>

                    <group string="Vista previa de Producto"
                           invisible="tipo_ingreso != 'producto' or state != 'previewed'">
                        <group>
                            <field name="preview_line_count" />
                            <field name="preview_total_volume_m3" />
                            <field name="preview_guide_no" />
                            <field name="preview_data" nolabel="1" />
                            <field name="preview_warnings" nolabel="1" />
                        </group>
                    </group>

                    <group string="Resumen documental — Ingreso por Volúmenes"
                           invisible="intake_modality != 'volume' or state != 'previewed'">
                        <group>
                            <field name="preview_guide_no" />
                            <field name="preview_guide_date" />
                            <field name="preview_supplier" />
                            <field name="preview_oc" />
                            <field name="preview_origin" />
                        </group>
                        <group>
                            <field name="preview_exchange_rate" />
                            <field name="preview_total_packages" />
                            <field name="preview_total_volume_m3" />
                        </group>
                        <group string="Nivel de detalle">
                            <field name="detalle_aplicado" />
                            <field name="detalle_motivo" invisible="not detalle_motivo" />
                            <field name="preview_line_count" />
                            <field name="preview_line_volume_m3" />
                        </group>
                        <group>
                            <field name="preview_warnings" nolabel="1" />
                        </group>
                    </group>

                    <notebook invisible="intake_modality != 'volume' or state != 'previewed'">
                        <page string="Detalle documental PDF" name="volume_document_detail">
                            <div class="text-muted" invisible="preview_has_detail">
                                Detalle documental no estructurado para este formato.
                                El PDF adjunto se conserva como fuente documental de consulta.
                            </div>
                            <div invisible="not preview_has_detail">
                                <field name="preview_document_lines" nolabel="1" />
                            </div>
                        </page>
                    </notebook>

                    <div class="alert alert-info"
                         role="alert"
                         invisible="state != 'previewed'">
                        Este resumen refleja los valores <strong>tal como fueron declarados
                        en el archivo</strong>, sin conversión de unidades ni descarte de
                        filas inválidas. El volumen final que se registrará en stock al
                        presionar "Continuar ingreso" puede diferir levemente, ya que el
                        sistema aplicará en ese momento las reglas de conversión y
                        validación correspondientes.
                    </div>

                    <div class="alert alert-info"
                         invisible="tipo_ingreso != 'procesado' or intake_modality != 'normal'"
                         role="alert">
                        El Excel se conservará sin transformar y será interpretado
                        por el flujo de Procesados, que mantiene varios paquetes
                        por N° de lote.
                    </div>

                    <div class="alert alert-info"
                         invisible="intake_modality != 'volume'"
                         role="alert">
                        El documento se procesará como Ingreso por Volúmenes.
                        El Packing List Excel es opcional y, si se adjunta, se
                        utilizará como respaldo o detalle adicional.
                    </div>

                    <div class="alert alert-warning"
                         invisible="not has_reading_warning"
                         role="alert">
                        <i class="fa fa-exclamation-triangle me-2" title="Advertencia de lectura"/>
                        <strong>Advertencia de lectura:</strong>
                        <field name="reading_warning" readonly="1" nolabel="1" />
                    </div>

                    <div class="alert alert-warning"
                         invisible="not profile_warning_message"
                         role="alert">
                        <strong>Advertencia de coherencia de perfil:</strong>
                        <field name="profile_warning_message" readonly="1" nolabel="1" />
                    </div>

                    <div class="alert alert-danger"
                         invisible="state != 'error' or not error_message"
                         role="alert">
                        <field name="error_message" nolabel="1" />
                    </div>

                    <group string="Registro creado" invisible="state != 'routed'">
                        <group>
                            <field name="target_model" />
                            <field name="target_res_id" />
                            <field name="target_reference" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_madenat_lumber_intake_wizard_list" model="ir.ui.view">
        <field name="name">madenat.lumber.intake.wizard.list</field>
        <field name="model">madenat.lumber.intake.wizard</field>
        <field name="arch" type="xml">
            <list string="Ingreso de Madera">
                <field name="tipo_ingreso" />
                <field name="excel_filename" />
                <field name="state" />
                <field name="has_reading_warning" optional="show" />
                <field name="target_reference" />
            </list>
        </field>
    </record>

    <record id="action_madenat_lumber_intake_wizard" model="ir.actions.act_window">
        <field name="name">Ingreso de Madera (Wizard)</field>
        <field name="res_model">madenat.lumber.intake.wizard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>