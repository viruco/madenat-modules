<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Ingreso de Madera — Puerta única de ingreso (fachada) de madenat_lumber_intake.

        El menú principal ahora abre la Consola Global de Ingresos (modelo
        consolidado readonly madenat.lumber.intake.console), no el historial
        del wizard. El wizard se conserva como mecanismo de creación y se
        lanza mediante la acción "Nuevo ingreso" enlazada en la consola.

        Integrado bajo la rama canónica de recepción del core:
          MADENAT Lumber → Operaciones → Abastecimiento → Gestión de Entradas
          (madenat_lumber_core.menu_ops_reception_cat)

        Visibilidad alineada al grupo operativo dueño del ACL del wizard
        (madenat_lumber_core.group_madenat_operaciones).
    -->
    <menuitem
        id="menu_madenat_lumber_intake_wizard"
        name="Ingreso de Madera"
        parent="madenat_lumber_core.menu_ops_reception_cat"
        action="action_madenat_lumber_intake_console"
        sequence="1"
        groups="madenat_lumber_core.group_madenat_operaciones"/>

    <!--
        WP-C (FASE 12): acceso directo y pre-filtrado a "Ingresos por Volúmenes"
        en la misma rama canónica de recepción:
          MADENAT Lumber → Operaciones → Abastecimiento → Gestión de Entradas
    -->
    <menuitem
        id="menu_madenat_lumber_intake_volume"
        name="Ingresos por Volúmenes"
        parent="madenat_lumber_core.menu_ops_reception_cat"
        action="action_madenat_lumber_intake_console_volume"
        sequence="2"
        groups="madenat_lumber_core.group_madenat_operaciones"/>

    <!--
        Consolidación de navegación: los accesos nativos a los modelos fuente
        (`Ingreso de Guías` y `Guías Procesadas`) quedan reservados a Jefatura de
        Operaciones (grupo avanzado/supervisión) para que el operador no tenga que
        distinguir entre flujos y trabaje por Ingreso de Madera. Se sobreescribe SOLO
        la visibilidad por grupo del menú del core; no se eliminan menús ni se
        modifica la acción subyacente (cambio reversible y sin pérdida funcional).
    -->
    <record id="madenat_lumber_core.menu_lumber_reception_pending" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('madenat_lumber_core.group_madenat_jefatura_operaciones')])]"/>
    </record>

    <record id="madenat_lumber_core.menu_guia_processing_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('madenat_lumber_core.group_madenat_jefatura_operaciones')])]"/>
    </record>

    <record id="madenat_lumber_core.menu_guia_processing_list" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('madenat_lumber_core.group_madenat_jefatura_operaciones')])]"/>
    </record>

    <!--
        P2-4: Inactivar la entrada temporal/duplicada "Ingreso de Madera New"
        (madenat_ingestion_engine.menu_madenat_ingestion_root, id 505).

        La puerta de entrada oficial, validada por UAT y base del manual, es
        "Ingreso de Madera" (id 500) -> madenat.lumber.intake.console.

        Se inactiva SOLO el metadato de menú por override XML desde Intake
        (que ya depende de madenat_ingestion_engine). No se elimina el modelo,
        las vistas ni la acción de madenat.ingestion.document, y no se
        modifica ni desinstala el módulo madenat_ingestion_engine.
    -->
    <record id="madenat_ingestion_engine.menu_madenat_ingestion_root" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>
</odoo>