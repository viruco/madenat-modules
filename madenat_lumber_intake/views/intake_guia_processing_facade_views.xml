<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================================
         FACHADA PROCESADOS — madenat.guia.processing
         Vista ligera de corrección (AD-55). Reduce el ruido del form
         pesado del core. Foco: contexto comercial breve + detalle de
         proceso/trazabilidad. Toda escritura sigue en el core.
         Seleccionada explícitamente desde action_open_source (Intake).
         NO reemplaza la vista estándar del core (fallback intacto).
         ============================================================ -->
    <record id="view_madenat_guia_processing_intake_facade_form" model="ir.ui.view">
        <field name="name">madenat.guia.processing.intake.facade.form</field>
        <field name="model">madenat.guia.processing</field>
        <field name="arch" type="xml">
            <form string="Modificar origen — Procesados">

                <header>
                    <field name="state" widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-warning="state in ('verified', 'processed')"
                           decoration-success="state == 'validated'"
                           decoration-muted="state == 'cancelled'"/>

                    <!-- Contexto visual de OC: match resumido en el header -->
                    <field name="oc_match_status" string="Match OC" nolabel="1"
                           class="text-muted fw-bold"
                           invisible="oc_match_status in ('not_found', False)"/>

                    <!-- Fachada de edición/corrección (patrón Producto):
                         - action_verify_data: validar los datos modificados.
                         - action_back_to_intake_console: volver a Ingreso de Madera.
                         El envío a stock se centraliza en la consola
                         (action_send_to_stock), NO en esta fachada.
                         Cancelar/reabrir pertenecen al flujo general de la
                         consola, no a esta pantalla. -->
                    <button name="action_verify_data"
                            type="object"
                            string="Verificar Datos"
                            class="btn-primary"
                            invisible="state not in ('draft', 'verified', 'processed')"/>
                    <button name="action_back_to_intake_console"
                            type="object"
                            string="Volver a Ingreso de Madera"
                            class="btn-secondary"
                            icon="fa-arrow-left"/>

                    <button name="action_reclassify"
                            type="object"
                            string="Reclasificar Tipo de Ingreso"
                            class="btn-secondary"
                            invisible="state not in ('draft', 'verified')"/>

                    <!-- 🏷️ Programa SV — historial de la etiqueta SV de la Guía
                         por Volumen (solo lectura; las operaciones se ejecutan
                         desde la etiqueta o su asistente controlado). -->
                    <!-- 🏷️ Programa SV — acciones SV aprobadas (Fase 2, AD-80).
                         Todas delegan en los wizards controlados y en el ledger
                         append-only del core; la fachada no escribe lotes,
                         volumen, saldo ni stock. -->
                    <field name="volume_lot_id" readonly="1" invisible="1"/>
                    <field name="intake_sv_reversible_rebaja_id" invisible="1"/>
                    <button name="action_sv_rename"
                            type="object"
                            string="Modificar etiqueta SV"
                            class="btn-secondary"
                            invisible="tipo_recepcion != 'granel' or not volume_lot_id"/>
                    <button name="action_sv_regularize_volume"
                            type="object"
                            string="Regularizar volumen"
                            class="btn-secondary"
                            invisible="tipo_recepcion != 'granel' or not volume_lot_id"/>
                    <button name="action_sv_rebaja"
                            type="object"
                            string="Rebajar etiqueta"
                            class="btn-secondary"
                            invisible="tipo_recepcion != 'granel' or not volume_lot_id"/>
                    <button name="action_intake_sv_reverse_rebaja"
                            type="object"
                            string="Reversar rebaja"
                            class="btn-secondary"
                            invisible="tipo_recepcion != 'granel' or not intake_sv_reversible_rebaja_id"/>
                    <button name="action_open_sv_history"
                            type="object"
                            string="🏷️ Ver historial SV"
                            class="btn-secondary"
                            icon="fa-history"
                            invisible="tipo_recepcion != 'granel' or not volume_lot_id"/>

                    <!-- Advertencia persistente y NO bloqueante de OC pendiente -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not oc_reference_raw or order_id or oc_match_status in ('single_match', 'manual', 'created')">
                        <i class="fa fa-exclamation-triangle"/>
                        OC documental sin vínculo real. AD-54 — la ingesta continúa;
                        la exigencia final de OC resuelta pertenece a Costeo/Valorización.
                    </div>

                    <!-- FIX 2026-08-21: advertencia NO bloqueante de proveedor no resuelto.
                         Visible cuando supplier_resolution_status es needs_manual/multi_match.
                         Muestra la nota de resolución (supplier_resolution_note). -->
                    <div class="alert alert-warning" role="alert"
                         invisible="supplier_resolution_status not in ('needs_manual', 'multi_match')">
                        <i class="fa fa-exclamation-triangle"/>
                        <strong>Proveedor documental pendiente de resolución.</strong><br/>
                        <field name="supplier_resolution_note" nolabel="1"/>
                    </div>
                </header>

                <sheet>
                    <notebook>

                        <!-- ================= GUÍA Y COMERCIAL ================= -->
                        <page string="Guía y comercial" name="guides_commercial">

                            <group>
                                <group>
                                    <field name="name" string="Número de Guía"/>
                                    <field name="date_emission" string="Fecha de Emisión"/>
                                    <field name="tipo_recepcion" string="Tipo de Recepción"/>
                                    <!-- Confirmación de retorno de servicio
                                         (solo ingreso de servicio). Identifica
                                         el retorno; NO bloquea la ingesta ni el
                                         envío a stock. Vacío = pendiente. -->
                                    <field name="service_return_confirmation"
                                           string="¿Es retorno de servicio?"
                                           widget="radio"
                                           options="{'horizontal': true}"
                                           invisible="tipo_recepcion != 'service'"
                                           readonly="state == 'validated'"/>
                                    <field name="partner_id" string="Proveedor / Transportista"/>
                                    <field name="toll_order_id"
                                           invisible="tipo_recepcion != 'service'"
                                           readonly="state in ('validated','processed')"/>
                                </group>
                                <group>
                                    <field name="oc_reference_raw" string="Referencia OC del documento"/>
                                    <field name="order_id" string="Orden de compra vinculada"/>
                                    <field name="oc_match_status" string="Estado de vinculación OC"/>
                                    <field name="oc_match_note" string="Observación de vinculación"/>
                                </group>
                            </group>

                            <!-- Totales mínimos operativos -->
                            <group>
                                <group>
                                    <field name="total_paquetes" string="Total Paquetes"/>
                                    <field name="total_lotes_unicos" string="Total Lotes"/>
                                </group>
                                <group>
                                    <field name="vol_comercial" string="Vol. Comercial (m³)"/>
                                    <field name="vol_shipment_m3" string="Vol. Embarque (m³)"/>
                                </group>
                            </group>

                            <!-- Evidencia documental (solo lectura) -->
                            <group string="📄 Evidencia documental" col="4">
                                <field name="vol_comercial_pdf" string="Vol. PDF/Guía (m³)" readonly="1" digits="[16, 3]"/>
                                <field name="packing_volume_declared_m3" string="Vol. Packing (m³)" readonly="1" digits="[16, 3]"/>
                                <field name="sum_vol_documental_m3" string="Suma líneas Packing (m³)" readonly="1" digits="[16, 3]"/>
                                <field name="diff_pdf_packing_m3" string="Δ PDF vs Packing (m³)" readonly="1" digits="[16, 3]"/>
                                <field name="diff_packing_lineas_m3" string="Δ Packing vs Líneas (m³)" readonly="1" digits="[16, 3]"/>
                                <field name="packing_pieces_declared" string="Piezas Packing" readonly="1"/>
                                <field name="packing_package_count_declared" string="Paquetes Packing" readonly="1"/>
                                <field name="documental_conciliation_state" string="Conciliación documental" widget="badge"
                                       decoration-success="documental_conciliation_state == 'consistent'"
                                       decoration-warning="documental_conciliation_state == 'partial'"
                                       decoration-danger="documental_conciliation_state == 'difference'"
                                       decoration-muted="documental_conciliation_state == 'not_available'"/>
                            </group>

                            <!-- 🏷️ Programa SV — etiqueta SV y su historial -->
                            <group string="🏷️ Etiqueta SV" col="4"
                                   invisible="tipo_recepcion != 'granel'">
                                <field name="volume_lot_id" string="Etiqueta SV" readonly="1"/>
                                <field name="sv_operation_count" string="Operaciones SV" readonly="1"/>
                            </group>

                        </page>

                        <!-- ================= PROCESO / SERVICIO ================= -->
                        <page string="Proceso" name="process_info">

                            <group>
                                <group>
                                    <field name="rate_usd" string="Tipo de Cambio USD"/>
                                    <field name="rate_date" string="Fecha Tipo Cambio"/>
                                    <field name="additional_cost" string="Costo Adicional"/>
                                </group>
                                <group>
                                    <field name="service_product_name" string="Descripción del Servicio"/>
                                    <field name="service_volume_m3" string="Volumen del Servicio (m³)"/>
                                    <field name="service_unit_price_clp" string="Precio Unitario (CLP/m³)"/>
                                    <field name="service_date" string="Fecha del Servicio"/>
                                    <field name="service_code" string="Código del Servicio"/>
                                </group>
                            </group>

                        </page>

                        <!-- ================= PACKING (LÍNEAS) ================= -->
                        <page string="Packing" name="detail_lines">

                            <!-- Fijar nominal masivo: reutiliza la acción window del
                                 core igual que Producto (mismo patrón, sin tocarlo). -->
                            <div class="mb-2">
                                <button name="%(madenat_lumber_core.action_madenat_guia_mass_update)d"
                                        type="action"
                                        string="⚡ Fijar Nominal Masivo"
                                        class="btn-secondary"
                                        invisible="tipo_recepcion == 'granel'"
                                        icon="fa-ruler-combined"
                                        context="{'active_id': id, 'active_ids': [id], 'active_model': 'madenat.guia.processing'}"/>
                            </div>

                            <field name="processing_line_ids" invisible="tipo_recepcion == 'granel'">
                                <list create="false" edit="true" delete="false">
                                    <field name="lot_name" string="Etiqueta / Lote"/>
                                    <field name="sku_original" string="SKU Original"/>
                                    <field name="raw_dims" string="Dim. Origen"/>
                                    <field name="product_id" string="Producto Maestro" readonly="1"/>
                                    <field name="subproducto_id" string="Subproducto / Grado"/>
                                    <field name="product_name_original" string="Texto Excel"/>
                                    <field name="pieces" string="Piezas"/>
                                    <field name="vol_documental_m3" string="Vol. Doc. (m³)"/>
                                    <field name="espesor_mm" string="Esp. Físico (mm)"/>
                                    <field name="espesor_nominal_mm" string="Esp. Nom (mm)"/>
                                    <field name="ancho_nominal_mm" string="Ancho Nom (mm)"/>
                                    <field name="largo_nominal_m" string="Largo Nom (m)"/>
                                    <field name="vol_purchase_m3" string="Vol. Compra (m³)"/>
                                    <field name="vol_shipment_m3" string="Vol. Embarque (m³)"/>
                                </list>
                            </field>

                            <!-- Ingreso por Volumen — detalle documental del Packing
                                 (mismo conjunto de filas que exponía la consola).
                                 Informativo, no bloqueante; editable para corrección. -->
                            <field name="volume_detail_line_ids"
                                   invisible="tipo_recepcion != 'granel'"
                                   editable="bottom">
                                <list>
                                    <field name="lot_or_package"/>
                                    <field name="material_code"/>
                                    <field name="description"/>
                                    <field name="volume_m3"/>
                                    <field name="uom"/>
                                    <field name="unit_price"/>
                                    <field name="line_amount"/>
                                    <field name="observation"/>
                                </list>
                            </field>

                        </page>

                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>